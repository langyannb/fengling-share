<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 后台常驻消息服务 (v1.0.35): 前台服务 + 通知权限 + 请求忽略电池优化 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启 (v1.0.36): 重启/更新后自动把常驻消息服务拉回来 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 包可见性: 声明 QQ 可见, 否则 Android 11+ resolveActivity(mqqapi://) 返回 null,
         无法直接拉起 QQ 加群, 只能回退网页版 -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqq" />
        </intent>
    </queries>
    <!-- 包可见性 (v1.1.2): Android 11+ 看不见别的包, 厂商「自启动管理」页就 resolveActivity=null,
         用户点「允许自启动」会静默失败。把要跳转的厂商设置包逐个声明进来。 -->
    <queries>
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
    </queries>                
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Fengling">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WebUpdateActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling" />
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling" />
        <!-- 后台常驻消息服务: 持有唯一的 SSE 长连接, 退到后台/桌面也不断 -->
        <!--
            android:stopWithTask="false" 是「被划掉也能收消息」的主机制 (v1.1.1):
            默认情况下用户把 App 从最近任务里划掉, 系统会连带 stopService 掉本服务;
            置 false 后划掉只回调 onTaskRemoved(), 前台服务继续持有 SSE 收消息。
        -->
        <service
            android:name=".service.MessageService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <!-- 兜底: 被 ROM 强杀 / 服务异常退出后由闹钟把服务拉回来 -->
        <receiver
            android:name=".receiver.ServiceRestartReceiver"
            android:exported="false" />
        <!-- 闹钟守护心跳 (v1.1.2): 约 120 秒一次, 服务该活却没活就拉回来, 并做一次轻量 HTTP 补拉。
             没有 intent-filter: 只用显式 PendingIntent + setExactAndAllowWhileIdle 唤醒, 不需要开机广播。 -->
        <receiver
            android:name=".receiver.KeepAliveReceiver"
            android:exported="false" />
        <!-- 兜底: 15 分钟周期的看门狗任务 (setPersisted), 进程被杀也会被系统重新拉起 -->
        <service
            android:name=".service.MessageJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 开机 / 应用更新后恢复常驻消息服务 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    
</manifest>