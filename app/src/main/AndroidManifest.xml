<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 后台常驻消息服务 (v1.0.35): 前台服务 + 通知权限 + 请求忽略电池优化 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 包可见性: 声明 QQ 可见, 否则 Android 11+ resolveActivity(mqqapi://) 返回 null,
         无法直接拉起 QQ 加群, 只能回退网页版 -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqq" />
        </intent>
    </queries>                
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Fengling">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WebUpdateActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling" />
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fengling" />
        <!-- 后台常驻消息服务: 持有唯一的 SSE 长连接, 退到后台/桌面也不断 -->
        <service
            android:name=".service.MessageService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    
</manifest>